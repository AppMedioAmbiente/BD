<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".register.Register1"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registro"
            android:textSize="35sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="15dp"
            app:srcCompat="@drawable/logo" />

        <!--TextView
            android:id="@+id/contactMsg"
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/white" /-->
        <EditText
            android:id="@+id/nickname"
            style="@style/fieldsColor"
            android:background="@drawable/redondedado"
            android:padding="5dp"
            android:layout_width="270dp"
            android:layout_height="50dp"
            android:autofillHints="emailAddress, phone"
            android:ems="10"
            android:hint="Nombre de usuario"
            android:inputType="textNoSuggestions"
            android:layout_margin="5dp" />

        <TextView
            android:id="@+id/nicknameMsg"
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="7dp"
            android:text="" />

        <EditText
            android:id="@+id/email"
            style="@style/fieldsColor"
            android:background="@drawable/redondedado"
            android:padding="5dp"
            android:layout_width="270dp"
            android:layout_height="50dp"
            android:autofillHints="emailAddress, phone"
            android:ems="10"
            android:hint="Correo electrónico"
            android:inputType="textEmailAddress"
            android:layout_margin="5dp" />

        <TextView
            android:id="@+id/emailMsg"
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="7dp"
            android:text="" />

        <EditText
            android:id="@+id/phone"
            style="@style/fieldsColor"
            android:background="@drawable/redondedado"
            android:padding="5dp"
            android:layout_width="270dp"
            android:layout_height="50dp"
            android:autofillHints="emailAddress, phone"
            android:ems="10"
            android:hint="Teléfono"
            android:inputType="phone"
            android:layout_margin="5dp" />

        <TextView
            android:id="@+id/phoneMsg"
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="7dp"
            android:text="" />

        <EditText
            android:id="@+id/password"
            style="@style/fieldsColor"
            android:background="@drawable/redondedado"
            android:padding="5dp"
            android:layout_width="270dp"
            android:layout_height="50dp"
            android:ems="10"
            android:hint="Contraseña"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:layout_margin="5dp" />

        <TextView
            android:id="@+id/passwordMsg"
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="7dp"
            android:text="" />

        <EditText
            android:id="@+id/repeat_password"
            style="@style/fieldsColor"
            android:background="@drawable/redondedado"
            android:padding="5dp"
            android:layout_width="270dp"
            android:layout_height="50dp"
            android:ems="10"
            android:hint="Confirmar contraseña"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:layout_margin="5dp" />

        <TextView
            android:id="@+id/repPassMsg"
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="7dp"
            android:text="" />

        <Button
            android:id="@+id/send"
            style="@style/botonsColor"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:text="Enviar"
            android:textSize="16sp"
            android:layout_margin="10dp" />

    </LinearLayout>
</ScrollView>