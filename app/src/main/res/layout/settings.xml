<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="top|center"
    android:orientation="vertical"
    tools:context=".Settings">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/Theme.FireLogin.AppBarOverlay">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/tbSettings"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:popupTheme="@style/Theme.FireLogin.PopupOverlay"
            app:title=" " />

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        style="@style/SomeSettingsColor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="40dp"
        android:background="@drawable/redondedado"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/imageView"
            style="@style/iconTint"
            android:layout_width="110dp"
            android:layout_height="match_parent"
            app:srcCompat="@drawable/configuraciones" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:text="Ajustes"
            android:textSize="55sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/personal_data"
        style="@style/TertiaryColor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:background="@drawable/redondedado"
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:padding="10dp">


        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="200dp"
            android:text="Datos Personales"
            android:textAlignment="textStart"
            android:textSize="20sp" />

        <ImageView
            android:id="@+id/imageView2"
            style="@style/iconTint"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:maxWidth="10dp"
            android:maxHeight="10dp"
            app:srcCompat="@drawable/editar" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/notification"
        style="@style/TertiaryColor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:background="@drawable/redondedado"
        android:clickable="true"
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="200dp"
            android:text="Notificaciones"
            android:textAlignment="textStart"
            android:textSize="20sp" />

        <ImageView
            android:id="@+id/imageView3"
            style="@style/iconTint"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:maxWidth="10dp"
            android:maxHeight="10dp"
            app:srcCompat="@drawable/notificacion" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/autentication"
        style="@style/TertiaryColor"
        android:layout_width="270dp"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:background="@drawable/redondedado"
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/textView3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="200dp"
            android:text="Autenticación"
            android:textAlignment="textStart"
            android:textSize="20sp" />

        <ImageView
            android:id="@+id/imageView4"
            style="@style/iconTint"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:maxWidth="10dp"
            android:maxHeight="10dp"
            app:srcCompat="@drawable/editar" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/s_interface"
        style="@style/TertiaryColor"
        android:layout_width="270dp"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:background="@drawable/redondedado"
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:padding="10dp">


        <TextView
            android:id="@+id/textView4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="200dp"
            android:text="Interfaz"
            android:textAlignment="textStart"
            android:textSize="20sp" />

        <ImageView
            android:id="@+id/imageView5"
            style="@style/iconTint"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:maxWidth="10dp"
            android:maxHeight="10dp"
            app:srcCompat="@drawable/editar1" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/s_deleteaccount"
        style="@style/TertiaryColor"
        android:layout_width="270dp"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:background="@drawable/redondedado"
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:padding="10dp">


        <TextView
            android:id="@+id/textView5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="200dp"
            android:text="Eliminar cuenta"
            android:textAlignment="textStart"
            android:textSize="20sp" />

        <ImageView
            android:id="@+id/imageView8"
            style="@style/iconTint"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:maxWidth="10dp"
            android:maxHeight="10dp"
            app:srcCompat="@drawable/eliminar" />

    </LinearLayout>

</LinearLayout>