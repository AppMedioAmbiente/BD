<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Event_Details">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:theme="@style/Theme.FireLogin.AppBarOverlay">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/tbEventDetails"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="?attr/colorPrimary"
                app:popupTheme="@style/Theme.FireLogin.PopupOverlay"
                app:title=" " />

        </com.google.android.material.appbar.AppBarLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:text="Detalles del evento"
            android:textAlignment="center"
            android:textSize="35sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:padding="10dp"
                android:text="Nombre del evento"
                android:textSize="20sp" />

            <EditText
                android:id="@+id/dtEventName"
                style="@style/fieldsColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:background="@drawable/redondedado"
                android:maxWidth="320dp"
                android:minWidth="270dp"
                android:padding="10dp"
                android:textSize="20sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:padding="10dp"
                android:text="Tipo de evento"
                android:textSize="20sp" />

            <Spinner
                android:id="@+id/dtEventType"
                style="@style/fieldsColor"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_margin="5dp"
                android:background="@drawable/redondedado"
                android:maxWidth="320dp"
                android:minWidth="270dp"
                android:padding="10dp"
                android:textSize="20sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:padding="10dp"
                android:text="Estatus del evento"
                android:textSize="20sp" />

            <Spinner
                android:id="@+id/dtEventStatus"
                style="@style/fieldsColor"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_margin="5dp"
                android:background="@drawable/redondedado"
                android:maxWidth="320dp"
                android:minWidth="270dp"
                android:padding="10dp"
                android:textSize="20sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:padding="10dp"
                android:text="Descripción"
                android:textSize="20sp" />

            <EditText
                android:id="@+id/dtEventDescrip"
                style="@style/fieldsColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:background="@drawable/redondedado"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:maxWidth="320dp"
                android:maxHeight="150dp"
                android:minWidth="270dp"
                android:overScrollMode="always"
                android:padding="10dp"
                android:scrollbarStyle="insideInset"
                android:scrollbars="vertical"
                android:textSize="20sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:layout_marginVertical="10dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:padding="10dp"
                android:text="Mapa de localización"
                android:textSize="20sp" />

            <!-- AQUÍ IRÍA EL MAPA -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:padding="10dp"
                android:text="Latitud y longitud del lugar"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/dtEventLat"
                    style="@style/fieldsColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:background="@drawable/redondedado"
                    android:inputType="numberSigned|numberDecimal"
                    android:maxWidth="190dp"
                    android:minWidth="175dp"
                    android:padding="10dp"
                    android:textSize="20sp" />

                <EditText
                    android:id="@+id/dtEventLong"
                    style="@style/fieldsColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:background="@drawable/redondedado"
                    android:inputType="numberSigned|numberDecimal"
                    android:maxWidth="190dp"
                    android:minWidth="175dp"
                    android:padding="10dp"
                    android:textSize="20sp" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:padding="10dp"
                android:text="Fecha y hora del evento"
                android:textSize="20sp" />

            <EditText
                android:id="@+id/dtEventDate"
                style="@style/fieldsColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:background="@drawable/redondedado"
                android:inputType="date"
                android:maxWidth="320dp"
                android:minWidth="270dp"
                android:padding="10dp"
                android:textSize="20sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:padding="10dp"
                android:text="Fecha y hora de término"
                android:textSize="20sp" />

            <EditText
                android:id="@+id/dtEventEndDate"
                style="@style/fieldsColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:background="@drawable/redondedado"
                android:inputType="datetime"
                android:maxWidth="320dp"
                android:minWidth="270dp"
                android:padding="10dp"
                android:textSize="20sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:padding="10dp"
                android:text="Materiales necesarios"
                android:textSize="20sp" />

            <EditText
                android:id="@+id/dtEventMaterials"
                style="@style/fieldsColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:background="@drawable/redondedado"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:maxWidth="320dp"
                android:maxHeight="150dp"
                android:minWidth="270dp"
                android:overScrollMode="always"
                android:padding="10dp"
                android:scrollbarStyle="insideInset"
                android:scrollbars="vertical"
                android:textSize="20sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:padding="10dp"
                android:text="Mínimo de voluntarios"
                android:textSize="20sp" />

            <EditText
                android:id="@+id/dtEventMinVolun"
                style="@style/fieldsColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:background="@drawable/redondedado"
                android:inputType="number"
                android:maxWidth="320dp"
                android:minWidth="270dp"
                android:padding="10dp"
                android:textSize="20sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:padding="10dp"
                android:text="No. de personas unidas"
                android:textSize="20sp" />

            <EditText
                android:id="@+id/dtEventNumPpl"
                style="@style/fieldsColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:background="@drawable/redondedado"
                android:enabled="false"
                android:inputType="number"
                android:maxWidth="320dp"
                android:minWidth="270dp"
                android:padding="10dp"
                android:textSize="20sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="90dp"
            android:layout_margin="20dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="12dp">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/deleteEvent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:backgroundTint="@color/red"
                app:srcCompat="@android:drawable/ic_menu_delete" />

            <Button
                android:id="@+id/btnLeave"
                style="@style/botonsColor"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_margin="10dp"
                android:maxWidth="150dp"
                android:text="Salir" />

            <Button
                android:id="@+id/btnJoin"
                style="@style/botonsColor"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_margin="10dp"
                android:maxWidth="150dp"
                android:text="Unirse"/>

            <Button
                android:id="@+id/btnModifyEvent"
                style="@style/botonsColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:maxWidth="150dp"
                android:text="Guardar" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>