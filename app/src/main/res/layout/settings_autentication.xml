<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="top|center"
    android:orientation="vertical"
    tools:context=".Settings_Autentication">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/Theme.FireLogin.AppBarOverlay">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/tbAuthSettings"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:popupTheme="@style/Theme.FireLogin.PopupOverlay"
            app:title="Ajustes de autenticación" />

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        style="@style/SomeSettingsColor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="40dp"
        android:background="@drawable/redondedado"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/imageView"
            style="@style/iconTint"
            android:layout_width="110dp"
            android:layout_height="match_parent"
            app:srcCompat="@drawable/configuraciones" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:text="Ajustes"
            android:textSize="55sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textView10"
            android:layout_width="210dp"
            android:layout_height="wrap_content"
            android:layout_margin="10sp"
            android:background="@drawable/redondedado"
            android:backgroundTint="#6D8967"
            android:maxWidth="250dp"
            android:paddingHorizontal="17dp"
            android:paddingVertical="12dp"
            android:text="Correo Electronico"
            android:textAlignment="center"
            android:textSize="20sp" />

        <Button
            android:id="@+id/button4"
            style="@style/botonsColor"
            android:layout_width="210dp"
            android:layout_height="wrap_content"
            android:layout_marginVertical="5dp"
            android:maxWidth="210dp"
            android:text="Activar"
            android:textSize="16sp" />


    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textView19"
            android:layout_width="210dp"
            android:layout_height="wrap_content"
            android:layout_margin="10sp"
            android:background="@drawable/redondedado"
            android:backgroundTint="#6D8967"
            android:maxWidth="250dp"
            android:paddingHorizontal="17dp"
            android:paddingVertical="12dp"
            android:text="Numero de Celular"
            android:textAlignment="center"
            android:textSize="20sp" />

        <Button
            android:id="@+id/button3"
            style="@style/botonsColor"
            android:layout_width="210dp"
            android:layout_height="wrap_content"
            android:layout_marginVertical="5dp"
            android:maxWidth="210dp"
            android:text="Activar"
            android:textSize="16sp" />

    </LinearLayout>

</LinearLayout>