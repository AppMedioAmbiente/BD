<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    tools:context=".register.Login">

    <TextView
        android:id="@+id/header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:text="Inicio de sesión"
        android:textSize="35sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:layout_marginBottom="40dp"
        app:srcCompat="@drawable/logo" />

    <EditText
        android:id="@+id/contact"
        style="@style/fieldsColor"
        android:background="@drawable/redondedado"
        android:padding="5dp"
        android:layout_width="270dp"
        android:layout_height="50dp"
        android:autofillHints="emailAddress, phone"
        android:hint="Correo electrónico"
        android:inputType="textEmailAddress"
        android:layout_marginBottom="30dp" />

    <EditText
        android:id="@+id/password"
        style="@style/fieldsColor"
        android:background="@drawable/redondedado"
        android:padding="5dp"
        android:layout_width="270dp"
        android:layout_height="50dp"
        android:autofillHints="no"
        android:hint="Contraseña"
        android:inputType="textPassword"
        android:layout_marginBottom="20dp"
         />

    <TextView
        android:id="@+id/ResetPsw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enviar correo de restablecimiento de contraseña"
        android:textAlignment="center"
        android:textColor="@color/purple_500"
        android:textSize="20dp"
        android:layout_marginBottom="45dp"/>

    <Button
        android:id="@+id/Send"
        style="@style/botonsColor"
        android:layout_width="170dp"
        android:layout_height="wrap_content"
        android:text="Enviar"
        android:textSize="16sp"
        android:layout_marginBottom="35dp" />

    <Button
        android:id="@+id/Rsing_up"
        style="@style/botonsColor"
        android:layout_width="170dp"
        android:layout_height="wrap_content"
        android:text="Registrarse"
        android:textSize="16sp"
        android:layout_marginBottom="35dp" />

</LinearLayout>