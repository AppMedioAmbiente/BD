<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="top|center"
    tools:context=".Settings_DA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="top|center">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:theme="@style/Theme.FireLogin.AppBarOverlay">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/tbPDSettings"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="?attr/colorPrimary"
                app:popupTheme="@style/Theme.FireLogin.PopupOverlay"
                app:title="Ajustes de eliminación de cuenta"/>

        </com.google.android.material.appbar.AppBarLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_margin="40dp"
            android:padding="12dp"
            android:background="@drawable/redondedado"
            android:backgroundTint="#00659a">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="120dp"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/configuraciones"
                style="@style/iconTint"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:text="Ajustes"
                android:textSize="55sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="5dp">

            <TextView
                android:id="@+id/text_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="250dp"
                android:text="Correo Electronico:"
                android:textSize="20sp"
                android:layout_margin="10dp"
                android:background="@drawable/redondedado"
                android:backgroundTint="#6D8967"
                android:padding="10dp" />

            <EditText
                android:id="@+id/email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="200dp"
                android:textSize="20sp"
                android:hint="Aqui"
                android:layout_margin="10dp"
                android:background="@drawable/redondedado"
                android:backgroundTint="#6D8967"
                android:padding="10dp" />

            <TextView
                android:id="@+id/text_passsword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="250dp"
                android:text="Ingresa tu contraseña:"
                android:textSize="20sp"
                android:layout_margin="10dp"
                android:background="@drawable/redondedado"
                android:backgroundTint="#6D8967"
                android:padding="10dp" />

            <EditText
                android:id="@+id/password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="250dp"
                android:hint="Aqui"
                android:textSize="20sp"
                android:layout_margin="10dp"
                android:background="@drawable/redondedado"
                android:backgroundTint="#6D8967"
                android:padding="10dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="95dp"
            android:layout_margin="20dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="12dp">

            <Button
                android:id="@+id/cancelPDBtn"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_margin="10dp"
                android:background="@drawable/redondedado"
                android:maxWidth="150dp"
                android:minHeight="10dp"
                android:text="Cancelar"/>

            <Button
                android:id="@+id/delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:background="@drawable/redondedado"
                android:maxWidth="150dp"
                android:minHeight="170dp"
                android:text="Eliminar" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
