<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/purple_200"
    tools:context=".ui.countryTemplate.CountrySelector">

    <TextView
        android:id="@+id/select_country"
        style="@style/botonsColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/redondedado"
        android:backgroundTint="#6D8967"
        android:maxWidth="320dp"
        android:minWidth="270dp"
        android:padding="10dp"
        android:clickable="true"
        android:focusable="true"
        android:textSize="20sp"
        android:text="Seleccionar un Pais"/>

    <Spinner
        android:id="@+id/select_state"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/redondedado"
        android:backgroundTint="#6D8967"
        android:maxWidth="320dp"
        android:minWidth="270dp"
        android:padding="10dp"
        android:textSize="20sp"
        android:layout_marginTop="10dp"
        style="@style/fieldsColor">
    </Spinner>
</LinearLayout>