<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="top|center"
    android:background="@color/mainColor"
    tools:context=".Settings_PD">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/Theme.FireLogin.AppBarOverlay">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/tbPDSettings"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:popupTheme="@style/Theme.FireLogin.PopupOverlay"
            app:title="Ajustes de datos personales"/>

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="top|center">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_margin="40dp"
            android:padding="12dp"
            android:background="@drawable/redondedado"
            android:backgroundTint="#00659a">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="120dp"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/configuraciones" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:text="Ajustes"
                android:textSize="55sp"
                android:textColor="@color/white" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="5dp">

            <TextView
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:background="@drawable/redondedado"
                android:backgroundTint="#6D8967"
                android:maxWidth="250dp"
                android:padding="10dp"
                android:text="Nombre(s)"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <EditText
                android:id="@+id/show_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:background="@drawable/redondedado"
                android:backgroundTint="#6D8967"
                android:minWidth="200dp"
                android:padding="10dp"
                android:textColor="@color/white"
                android:textSize="20sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="5dp">

            <TextView
                android:id="@+id/surname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:background="@drawable/redondedado"
                android:backgroundTint="#6D8967"
                android:maxWidth="250dp"
                android:padding="10dp"
                android:text="Apellido(s):"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <EditText
                android:id="@+id/show_surnname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:background="@drawable/redondedado"
                android:backgroundTint="#6D8967"
                android:minWidth="200dp"
                android:padding="10dp"
                android:textColor="@color/white"
                android:textSize="20sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="5dp">

            <TextView
                android:id="@+id/birthdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="250dp"
                android:text="Fecha de Nacimiento:"
                android:textSize="20sp"
                android:layout_margin="10dp"
                android:textColor="@color/white"
                android:background="@drawable/redondedado"
                android:backgroundTint="#6D8967"
                android:padding="10dp" />

            <EditText
                android:id="@+id/show_birthdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="200dp"
                android:textSize="20sp"
                android:layout_margin="10dp"
                android:textColor="@color/white"
                android:background="@drawable/redondedado"
                android:backgroundTint="#6D8967"
                android:padding="10dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="5dp">

            <TextView
                android:id="@+id/email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="250dp"
                android:text="Correo Electronico:"
                android:textSize="20sp"
                android:layout_margin="10dp"
                android:textColor="@color/white"
                android:background="@drawable/redondedado"
                android:backgroundTint="#6D8967"
                android:padding="10dp" />

            <EditText
                android:id="@+id/show_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="200dp"
                android:textSize="20sp"
                android:layout_margin="10dp"
                android:textColor="@color/white"
                android:background="@drawable/redondedado"
                android:backgroundTint="#6D8967"
                android:padding="10dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="95dp"
            android:layout_margin="20dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="12dp">

            <Button
                android:id="@+id/cancelPDBtn"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_margin="10dp"
                android:background="@drawable/redondedado"
                android:maxWidth="150dp"
                android:minHeight="10dp"
                android:text="Cancelar" />

            <Button
                android:id="@+id/save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:background="@drawable/redondedado"
                android:maxWidth="150dp"
                android:minHeight="170dp"
                android:text="Guardar" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
