<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="top|center"
    android:background="#082B11"
    tools:context="Settings_PD">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_margin="40dp"
        android:padding="12dp"
        android:background="@drawable/redondedado"
        android:backgroundTint="#00659a">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            app:srcCompat="@drawable/configuraciones"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:text="Ajustes"
            android:textSize="55sp"
            android:textColor="@color/white"/>

    </LinearLayout>

    <TextView
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10sp"
        android:background="@drawable/redondedado"
        android:backgroundTint="#6D8967"
        android:maxWidth="250sp"
        android:padding="10sp"
        android:text="Nombre(s)"
        android:textColor="@color/white"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/birthdate"
        android:layout_width="wrap_content"
        android:maxWidth="250sp"
        android:layout_height="wrap_content"
        android:text="Fecha de Nacimiento:"
        android:textSize="20sp"
        android:layout_margin="10sp"
        android:textColor="@color/white"
        android:background="@drawable/redondedado"
        android:backgroundTint="#6D8967"
        android:padding="10sp" />

    <TextView
        android:id="@+id/nickname"
        android:layout_width="wrap_content"
        android:maxWidth="250sp"
        android:layout_height="wrap_content"
        android:text="Nombre de usuario:  "
        android:textSize="20sp"
        android:layout_margin="10sp"
        android:textColor="@color/white"
        android:background="@drawable/redondedado"
        android:backgroundTint="#6D8967"
        android:padding="10sp" />

    <TextView
        android:id="@+id/email"
        android:layout_width="wrap_content"
        android:maxWidth="250sp"
        android:layout_height="wrap_content"
        android:text="Correo Electronico:"
        android:textSize="20sp"
        android:layout_margin="10sp"
        android:textColor="@color/white"
        android:background="@drawable/redondedado"
        android:backgroundTint="#6D8967"
        android:padding="10sp" />

    <TextView
        android:id="@+id/phone"
        android:layout_width="wrap_content"
        android:maxWidth="250sp"
        android:layout_height="wrap_content"
        android:text="Numero de Celular: "
        android:textSize="20sp"
        android:layout_margin="10sp"
        android:textColor="@color/white"
        android:background="@drawable/redondedado"
        android:backgroundTint="#6D8967"
        android:padding="10sp" />

    <TextView
        android:id="@+id/stateOfResidence"
        android:layout_width="wrap_content"
        android:maxWidth="250sp"
        android:layout_height="wrap_content"
        android:text="Estado de Residencia: "
        android:textSize="20sp"
        android:layout_margin="15sp"
        android:textColor="@color/white"
        android:background="@drawable/redondedado"
        android:backgroundTint="#6D8967"
        android:padding="10sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="95dp"
        android:layout_margin="20dp"
        android:gravity="center"
        android:maxWidth="10sp"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/button2"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_margin="10sp"
            android:background="@drawable/redondedado"
            android:maxWidth="150sp"
            android:minHeight="10sp"
            android:text="Cancelar" />


        <Button
            android:id="@+id/button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10sp"
            android:background="@drawable/redondedado"
            android:maxWidth="150sp"
            android:minHeight="170sp"
            android:text="Guardar" />

    </LinearLayout>

</LinearLayout>