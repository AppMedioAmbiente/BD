<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="top|center"
    android:orientation="vertical"
    tools:context=".Settings_PD">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top|center"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:theme="@style/Theme.FireLogin.AppBarOverlay">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/tbPDSettings"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="?attr/colorPrimary"
                app:popupTheme="@style/Theme.FireLogin.PopupOverlay"
                app:title="Ajustes de datos personales" />

        </com.google.android.material.appbar.AppBarLayout>

        <LinearLayout
            style="@style/SomeSettingsColor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="40dp"
            android:background="@drawable/redondedado"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:id="@+id/imageView"
                style="@style/iconTint"
                android:layout_width="110dp"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/configuraciones" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:text="Ajustes"
                android:textSize="55sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:background="@drawable/redondedado"
                android:backgroundTint="@color/transparent"
                android:maxWidth="250dp"
                android:padding="10dp"
                android:text="Nombre(s):"
                android:textSize="20sp" />

            <EditText
                android:id="@+id/show_name"
                style="@style/fieldsColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:background="@drawable/redondedado"
                android:maxWidth="320dp"
                android:minWidth="270dp"
                android:padding="10dp"
                android:textSize="20sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/surname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:background="@drawable/redondedado"
                android:backgroundTint="@color/transparent"
                android:maxWidth="250dp"
                android:padding="10dp"
                android:text="Apellido(s):"
                android:textSize="20sp" />

            <EditText
                android:id="@+id/show_surnname"
                style="@style/fieldsColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:background="@drawable/redondedado"
                android:maxWidth="320dp"
                android:minWidth="270dp"
                android:padding="10dp"
                android:textSize="20sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/birthdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:background="@drawable/redondedado"
                android:backgroundTint="@color/transparent"
                android:maxWidth="250dp"
                android:padding="10dp"
                android:text="Fecha de Nacimiento:"
                android:textSize="20sp" />

            <EditText
                android:id="@+id/show_birthdate"
                style="@style/fieldsColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:background="@drawable/redondedado"
                android:maxWidth="320dp"
                android:minWidth="270dp"
                android:padding="10dp"
                android:textSize="20sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_country"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:background="@drawable/redondedado"
                android:backgroundTint="@color/transparent"
                android:maxWidth="250dp"
                android:padding="10dp"
                android:text="País:"
                android:textSize="20sp" />

<!--            <EditText-->
<!--                android:id="@+id/country"-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:layout_margin="10dp"-->
<!--                android:background="@drawable/redondedado"-->
<!--                android:backgroundTint="#6D8967"-->
<!--                android:maxWidth="320dp"-->
<!--                android:minWidth="270dp"-->
<!--                android:padding="10dp"-->
<!--                android:textSize="20sp" />-->
            <TextView
                android:id="@+id/show_country"
                style="@style/fieldsColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:background="@drawable/redondedado"
                android:maxWidth="320dp"
                android:minWidth="270dp"
                android:padding="10dp"
                android:clickable="true"
                android:focusable="true"
                android:textSize="20sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:background="@drawable/redondedado"
                android:backgroundTint="@color/transparent"
                android:maxWidth="250dp"
                android:padding="10dp"
                android:text="Estado:"
                android:textSize="20sp" />

<!--            <EditText-->
<!--                android:id="@+id/state"-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:layout_margin="10dp"-->
<!--                android:background="@drawable/redondedado"-->
<!--                android:backgroundTint="#6D8967"-->
<!--                android:maxWidth="320dp"-->
<!--                android:minWidth="270dp"-->
<!--                android:padding="10dp"-->
<!--                android:textSize="20sp" />-->

            <Spinner
                android:id="@+id/show_state"
                style="@style/fieldsColor"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_margin="10dp"
                android:background="@drawable/redondedado"
                android:maxWidth="320dp"
                android:minWidth="270dp"
                android:padding="10dp"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_nickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:background="@drawable/redondedado"
                android:backgroundTint="@color/transparent"
                android:maxWidth="250dp"
                android:padding="10dp"
                android:text="Nombre de usuario:"
                android:textSize="20sp" />

            <EditText
                android:id="@+id/nickname"
                style="@style/fieldsColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:background="@drawable/redondedado"
                android:maxWidth="320dp"
                android:minWidth="270dp"
                android:padding="10dp"
                android:textSize="20sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:background="@drawable/redondedado"
                android:backgroundTint="@color/transparent"
                android:maxWidth="250dp"
                android:padding="10dp"
                android:text="Correo Electronico:"
                android:textSize="20sp" />

            <EditText
                android:id="@+id/show_email"
                style="@style/fieldsColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:background="@drawable/redondedado"
                android:maxWidth="320dp"
                android:minWidth="270dp"
                android:padding="10dp"
                android:textSize="20sp" />

            <EditText
                android:id="@+id/show_password"
                style="@style/fieldsColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:background="@drawable/redondedado"
                android:hint="Ingresa tu contraseña:"
                android:inputType="textPassword"
                android:maxWidth="320dp"
                android:minWidth="270dp"
                android:padding="10dp"
                android:textSize="20sp"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="95dp"
            android:layout_margin="20dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="12dp">

            <Button
                android:id="@+id/cancelPDBtn"
                style="@style/botonsColor"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_margin="10dp"
                android:maxWidth="150dp"
                android:minHeight="10dp"
                android:text="Cancelar" />

            <Button
                android:id="@+id/save"
                style="@style/botonsColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:maxWidth="150dp"
                android:minHeight="170dp"
                android:text="Guardar" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>