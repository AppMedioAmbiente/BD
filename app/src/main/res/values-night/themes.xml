<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.FireLogin" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/DarkPrimaryColor</item>
        <item name="colorPrimaryVariant">@color/DarkPrimaryVariantColor</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/DarkSecondaryColor</item>
        <item name="colorSecondaryVariant">@color/DarkSecondaryVariantColor</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/black</item>
        <!-- Customize your theme here. -->
        <item name="android:windowBackground">@color/DarkBackgroundColor</item>
        <item name="android:textColor">@color/white</item>
        <item name="sideNavBarColor">@color/botonsDarkColor</item>
    </style>

    <style name="SpinnerTextStyle" parent="Widget.AppCompat.Spinner">
        <item name="android:textColor">@color/red</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Theme.FireLogin.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.FireLogin.AppBarOverlay" >
        <item name="android:backgroundTint">@color/DarkBackgroundColor</item>
    </style>

    <style name="Theme.FireLogin.PopupOverlay" >
        <item name="android:backgroundTint">@color/DarkBackgroundColor</item>
    </style>

    <style name="iconTint">
        <item name="android:tint">@color/white</item>
    </style>

    <style name="cardsBgColor">
        <item name="android:backgroundTint">@color/cardsBgDarkColor</item>
    </style>

    <style name="botonsColor">
        <item name="android:backgroundTint">@color/botonsDarkColor</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SomeSettingsColor">
        <item name="android:backgroundTint">@color/SomeSettingsDarkColor</item>
    </style>

    <style name="TertiaryColor">
        <item name="android:backgroundTint">@color/DarkTertiaryColor</item>
    </style>

    <style name="navHeaderTextColor">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="report">
        <item name="android:backgroundTint">@color/botonsDarkColor</item>
        <item name="android:textColor">@color/red</item>
    </style>

    <style name="fieldsColor">
        <item name="android:backgroundTint">@color/fieldsDarkColor</item>
    </style>
</resources>