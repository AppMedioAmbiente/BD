<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.FireLogin" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/LightPrimaryColor</item>
        <item name="colorPrimaryVariant">@color/LightPrimaryVariantColor</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/LightSecondaryColor</item>
        <item name="colorSecondaryVariant">@color/LightSecondaryVariantColor</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/black</item>
        <!-- Customize your theme here. -->
        <item name="android:windowBackground">@color/LightBackgroundColor</item>
        <item name="android:textColor">@color/black</item>
        <item name="sideNavBarColor">@color/botonsLightColor</item>
    </style>

    <style name="SpinnerTextStyle" parent="Widget.AppCompat.Spinner">
        <item name="android:textColor">@color/red</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Theme.FireLogin.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.FireLogin.AppBarOverlay" >
        <item name="android:backgroundTint">@color/transparent</item>
    </style>

    <style name="Theme.FireLogin.PopupOverlay" >
        <item name="android:backgroundTint">@color/transparent</item>
    </style>

    <style name="iconTint">
        <item name="android:tint">@color/black</item>
    </style>

    <style name="cardsBgColor">
        <item name="android:backgroundTint">@color/cardsBgLightColor</item>
    </style>

    <style name="botonsColor">
        <item name="android:backgroundTint">@color/botonsLightColor</item>
    </style>

    <style name="SomeSettingsColor">
        <item name="android:backgroundTint">@color/SomeSettingsLightColor</item>
    </style>

    <style name="TertiaryColor">
        <item name="android:backgroundTint">@color/LightTertiaryColor</item>
    </style>

    <style name="navHeaderTextColor">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="report">
        <item name="android:backgroundTint">@color/botonsLightColor</item>
        <item name="android:textColor">@color/lightRed</item>
    </style>

    <style name="fieldsColor">
        <item name="android:backgroundTint">@color/fieldsLightColor</item>
    </style>
</resources>