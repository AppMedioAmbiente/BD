<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="top|center"
    android:background="#082B11">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_margin="40dp"
        android:padding="12dp"
        android:background="@drawable/redondedado"
        android:backgroundTint="#00659a">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            app:srcCompat="@drawable/configuraciones"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:text="Ajustes"
            android:textSize="55sp"
            android:textColor="@color/white"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_margin="10dp">

        <TextView
            android:id="@+id/textView10"
            android:layout_width="wrap_content"
            android:maxWidth="250sp"
            android:layout_height="wrap_content"
            android:text="Correo Electronico"
            android:textSize="20sp"
            android:layout_margin="10sp"
            android:textColor="@color/white"
            android:background="@drawable/redondedado"
            android:backgroundTint="#6D8967"
            android:paddingVertical="12dp"
            android:paddingHorizontal="16dp" />
        <Button
            android:id="@+id/button4"
            android:layout_width="match_parent"
            android:maxWidth="80sp"
            android:layout_height="wrap_content"
            android:text="Activar" />


    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_margin="10dp">

        <TextView
            android:id="@+id/textView19"
            android:layout_width="wrap_content"
            android:maxWidth="250sp"
            android:layout_height="wrap_content"
            android:text="Numero de Celular"
            android:textAlignment="center"
            android:textSize="20sp"
            android:layout_margin="10sp"
            android:textColor="@color/white"
            android:background="@drawable/redondedado"
            android:backgroundTint="#6D8967"
            android:paddingVertical="12dp"
            android:paddingHorizontal="16dp" />

        <Button
            android:id="@+id/button3"
            android:layout_width="match_parent"
            android:maxWidth="80sp"
            android:layout_height="wrap_content"
            android:text="Activar" />

    </LinearLayout>

</LinearLayout>